.DS_Store
.idea/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
dist/
build/
*.egg-info/

# Freqtrade runtime state is local. The empty directories remain versioned.
user_data/data/*
!user_data/data/.gitkeep
user_data/logs/*
!user_data/logs/.gitkeep
user_data/backtest_results/
user_data/hyperopt_results/
user_data/plot/

# Control-plane runtime state is local and append-only.
user_data/audit/*.jsonl
user_data/audit/*.json
!user_data/audit/.gitkeep

# WorkBuddy workspace-local data (daily logs, memory) is never committed.
.workbuddy/

# Secrets are forbidden in this repository.
.env
.env.*
*.pem
*.key
*live*.json

# Runtime smoke evidence packages are local.
user_data/audit/runtime-smoke-*/

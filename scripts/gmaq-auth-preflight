#!/usr/bin/env python3
"""GMAQ authorized read-only account preflight.

Uses ONLY signed GET endpoints. Never places orders, never mutates state,
and never prints or stores credentials. Credentials are read from
.env.readonly (gitignored). Run only with the user's explicit, per-session
authorization.
"""

import argparse
import base64
import hashlib
import hmac
import json
import pathlib
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
ENV_FILE = ROOT / ".env.readonly"
AUDIT_DIR = ROOT / "user_data" / "audit"
OUTPUT_PATH = AUDIT_DIR / "account-preflight.json"

FAPI = "https://fapi.binance.com"
PAPI = "https://papi.binance.com"
SAPI = "https://api.binance.com"
TIMEOUT_S = 10


def read_creds() -> tuple[str, str]:
    if not ENV_FILE.exists():
        return "", ""
    values = {}
    for line in ENV_FILE.read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    return values.get("GMAQ_READ_KEY", ""), values.get("GMAQ_READ_SECRET", "")


def classify_secret(secret: str) -> str:
    """Return 'hmac', 'ed25519-der', 'ed25519-pem', or 'unknown'.

    Binance's current HMAC secrets are 64-char alphanumeric strings (the
    legacy 64-hex format is a subset); Ed25519 keys arrive as PEM files or
    base64 blobs that typically contain '+' or '/'.
    """
    stripped = secret.strip().rstrip("=")
    if len(stripped) == 64 and all(c.isalnum() for c in stripped):
        return "hmac"
    if "-----BEGIN" in secret:
        return "ed25519-pem"
    if len(stripped) == 64 and all(
        c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/_-" for c in stripped
    ) and any(c in "+/" for c in stripped):
        return "ed25519-der"
    return "unknown"


def sign(params: dict, secret: str) -> str:
    query = urllib.parse.urlencode(sorted(params.items()))
    kind = classify_secret(secret)
    if kind == "hmac":
        return hmac.new(secret.encode(), query.encode(), hashlib.sha256).hexdigest()
    if kind in ("ed25519-der", "ed25519-pem"):
        return ed25519_sign(query, secret, kind)
    raise ValueError(f"unsupported secret format: {kind}")


def ed25519_sign(payload: str, secret: str, kind: str) -> str:
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

    if kind == "ed25519-pem":
        private = serialization.load_pem_private_key(secret.encode(), password=None)
    else:
        der = base64.b64decode(secret.strip() + "=" * (-len(secret.strip()) % 4))
        try:
            private = serialization.load_der_private_key(der, password=None)
        except ValueError:
            # Binance may expose the raw 32-byte seed instead of PKCS8.
            private = Ed25519PrivateKey.from_private_bytes(der)
    if not isinstance(private, Ed25519PrivateKey):
        raise ValueError("key is not Ed25519")
    signature = private.sign(payload.encode())
    return base64.b64encode(signature).decode()


def signed_get(base_url: str, path: str, params: dict, key: str, secret: str) -> tuple[int, object]:
    stamped = dict(params)
    stamped["timestamp"] = int(time.time() * 1000)
    stamped["recvWindow"] = 10_000
    stamped["signature"] = sign(stamped, secret)
    # Send parameters in the SAME sorted order used for signing; the server
    # verifies the signature over the exact query string received.
    url = f"{base_url}{path}?{urllib.parse.urlencode(sorted(stamped.items()))}"
    request = urllib.request.Request(url, headers={"X-MBX-APIKEY": key, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            return response.status, json.loads(response.read().decode())
    except urllib.error.HTTPError as error:
        try:
            body = json.loads(error.read().decode())
            return error.code, {"error": {"code": body.get("code"), "msg": body.get("msg")}}
        except (json.JSONDecodeError, ValueError):
            return error.code, None
    except (urllib.error.URLError, json.JSONDecodeError, OSError):
        return 0, None


def check(name: str, passed: bool, detail: str, kind: str = "read") -> dict:
    return {"name": name, "passed": passed, "detail": detail, "kind": kind}


def describe(code: int, body: object) -> str:
    if isinstance(body, dict) and isinstance(body.get("error"), dict):
        err = body["error"]
        return f"HTTP {code} ({err.get('code')} {err.get('msg')})"
    return f"HTTP {code}"


def run_preflight() -> dict:
    key, secret = read_creds()
    checks: list[dict] = []
    facts: dict = {}

    checks.append(check("credentials present", bool(key) and bool(secret), "read from .env.readonly"))
    if not key or not secret:
        manifest = {"verdict": "FAIL", "checks": checks, "note": "missing credentials; nothing was queried"}
        OUTPUT_PATH.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
        return manifest

    # --- account discovery: classic USD-M futures first, then Portfolio Margin ---
    code, account = signed_get(FAPI, "/fapi/v2/account", {}, key, secret)
    fapi_account = account
    account_type = None
    code_p = 0
    account_p = None
    if code == 200 and isinstance(account, dict):
        account_type = "usd_m_futures"
    else:
        code_p, account_p = signed_get(PAPI, "/papi/v1/account", {}, key, secret)
        if code_p == 200 and isinstance(account_p, dict):
            account_type = "portfolio_margin"
            account = account_p
        else:
            account = None
    facts["accountType"] = account_type
    checks.append(
        check(
            "account reachable",
            account_type is not None,
            account_type
            or f"neither fapi nor papi ({describe(code, fapi_account)}; {describe(code_p, account_p)})",
        )
    )
    if account is not None:
        facts["accountStatus"] = account.get("accountStatus")
        facts["feeTier"] = account.get("feeTier")
        facts["equity"] = "REDACTED"

    if account_type == "usd_m_futures":
        facts["canTrade"] = account.get("canTrade")
        facts["canWithdraw"] = account.get("canWithdraw")
        checks.append(check("canTrade", account.get("canTrade") is True, f"canTrade={account.get('canTrade')}"))
        checks.append(
            check(
                "withdrawals disabled for live canary",
                account.get("canWithdraw") is False,
                f"canWithdraw={account.get('canWithdraw')} (live canary requires a dedicated account with withdrawals disabled)",
                kind="live_requirement",
            )
        )
        code, dual = signed_get(FAPI, "/fapi/v1/positionSide/dual", {}, key, secret)
        if code == 200 and isinstance(dual, dict):
            facts["dualSidePosition"] = dual.get("dualSidePosition")
            checks.append(
                check(
                    "one-way position mode",
                    dual.get("dualSidePosition") is False,
                    f"dualSidePosition={dual.get('dualSidePosition')}",
                    kind="live_requirement",
                )
            )
        else:
            checks.append(check("position mode readable", False, f"HTTP {code}"))
        code, multi = signed_get(FAPI, "/fapi/v1/multiAssetsMargin", {}, key, secret)
        if code == 200 and isinstance(multi, dict):
            facts["multiAssetsMarginMode"] = multi.get("multiAssetsMargin")
            checks.append(
                check(
                    "single-asset mode",
                    multi.get("multiAssetsMargin") is False,
                    f"multiAssetsMargin={multi.get('multiAssetsMargin')}",
                    kind="live_requirement",
                )
            )
        else:
            checks.append(check("asset mode readable", False, f"HTTP {code}"))
        code, commission = signed_get(FAPI, "/fapi/v1/commissionRate", {"symbol": "ETHUSDT"}, key, secret)
        code_b, bracket = signed_get(FAPI, "/fapi/v1/leverageBracket", {"symbol": "ETHUSDT"}, key, secret)
    elif account_type == "portfolio_margin":
        # Portfolio Margin: unified margin; fees/MMR/mode via papi um endpoints.
        facts["marginMode"] = "unified_margin_pm"
        checks.append(
            check(
                "margin mode",
                False,
                "Portfolio Margin account uses unified cross margin; isolated-margin canary is incompatible",
                kind="live_requirement",
            )
        )
        code, dual = signed_get(PAPI, "/papi/v1/um/positionSide/dual", {}, key, secret)
        if code == 200 and isinstance(dual, dict):
            facts["dualSidePosition"] = dual.get("dualSidePosition")
            checks.append(
                check(
                    "one-way position mode",
                    dual.get("dualSidePosition") is False,
                    f"dualSidePosition={dual.get('dualSidePosition')} (hedge mode requires a switch for the canary layout)",
                    kind="live_requirement",
                )
            )
        else:
            checks.append(check("position mode readable", False, f"HTTP {code}"))
        code, commission = signed_get(PAPI, "/papi/v1/um/commissionRate", {"symbol": "ETHUSDT"}, key, secret)
        code_b, bracket = signed_get(PAPI, "/papi/v1/um/leverageBracket", {"symbol": "ETHUSDT"}, key, secret)
    else:
        facts["marginMode"] = None
        checks.append(check("margin mode readable", False, "account type is unknown"))
        code, commission = 0, None
        code_b, bracket = 0, None

    commission_ok = code == 200 and isinstance(commission, dict) and "makerCommissionRate" in commission
    checks.append(
        check(
            "fee rates on account",
            commission_ok,
            f"HTTP {code}" if code else "not queried because account type is unknown",
        )
    )
    if commission_ok:
        facts["commission"] = {
            "symbol": commission.get("symbol"),
            "maker": commission.get("makerCommissionRate"),
            "taker": commission.get("takerCommissionRate"),
            "status": "VERIFIED_ON_ACCOUNT",
        }
        checks.append(
            check(
                "taker fee matches or beats baseline",
                commission.get("takerCommissionRate") is not None,
                f"maker={commission.get('makerCommissionRate')} taker={commission.get('takerCommissionRate')}",
            )
        )

    bracket_ok = code_b == 200 and isinstance(bracket, list) and bracket
    checks.append(
        check(
            "leverage brackets readable",
            bracket_ok,
            f"HTTP {code_b}" if code_b else "not queried because account type is unknown",
        )
    )
    if bracket_ok:
        first = bracket[0].get("brackets", [{}])[0]
        facts["leverageBracketTier1"] = {
            "initialLeverage": first.get("initialLeverage"),
            "maintMarginRatio": first.get("maintMarginRatio"),
            "notionalFloor": first.get("notionalFloor"),
            "notionalCap": first.get("notionalCap"),
        }
        checks.append(
            check(
                "tier-1 MMR verified",
                first.get("maintMarginRatio") is not None,
                f"MMR={first.get('maintMarginRatio')} initialLeverage={first.get('initialLeverage')}",
            )
        )

    code, restrictions = signed_get(SAPI, "/sapi/v1/account/apiRestrictions", {}, key, secret)
    if code == 200 and isinstance(restrictions, dict):
        facts["apiRestrictions"] = {
            "ipRestrict": restrictions.get("ipRestrict"),
            "enableWithdrawals": restrictions.get("enableWithdrawals"),
            "enableInternalTransfer": restrictions.get("enableInternalTransfer"),
            "enableMargin": restrictions.get("enableMargin"),
            "enableFutures": restrictions.get("enableFutures"),
        }
        checks.append(check("API restrictions readable", True, "spot endpoint returned restrictions"))
        checks.append(
            check(
                "withdrawals disabled for live canary",
                restrictions.get("enableWithdrawals") is False,
                f"enableWithdrawals={restrictions.get('enableWithdrawals')}",
                kind="live_requirement",
            )
        )
    else:
        facts["apiRestrictions"] = None
        checks.append(check("API restrictions readable", False, f"HTTP {code} (non-fatal for research)"))

    read_failures = [item["name"] for item in checks if not item["passed"] and item.get("kind", "read") == "read"]
    manifest = {
        "scope": "authorized read-only session; GET requests only",
        "fetched_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "verdict": "PASS_READONLY" if not read_failures else "PARTIAL",
        "checks": checks,
        "facts": facts,
        "secrets": "none stored",
        "live_readiness_note": (
            f"Account fee rates are {'VERIFIED' if commission_ok else 'UNVERIFIED'}; "
            f"tier-1 MMR is {'VERIFIED' if bracket_ok else 'UNVERIFIED'}. "
            f"Account layout is {account_type or 'UNKNOWN'}; the canary requires "
            "an isolated-margin-compatible one-way USD-M layout. "
            "Live still requires: dedicated account/solo operator, withdrawals "
            "disabled, approved limits, secret management, alert routing, and "
            "the 48-72h soak evidence."
        ),
    }
    AUDIT_DIR.mkdir(parents=True, exist_ok=True)
    OUTPUT_PATH.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    return manifest


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gmaq-auth-preflight", description="Authorized read-only account preflight (GET only)")
    args = parser.parse_args(argv)
    manifest = run_preflight()
    print(json.dumps(manifest, ensure_ascii=False, indent=2))
    return 0 if manifest["verdict"] == "PASS_READONLY" else 1


if __name__ == "__main__":
    sys.exit(main())

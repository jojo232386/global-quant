#!/usr/bin/env python3
"""Interactively update .env.readonly credentials.

Prompts for the API key and secret with hidden input, writes the file
atomically with 0600 permissions, and never prints any part of either value.
"""

import getpass
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
ENV_FILE = ROOT / ".env.readonly"


def main() -> int:
    key = getpass.getpass("API Key (input hidden): ").strip()
    if not key:
        print("STOP: empty API Key", file=sys.stderr)
        return 1
    secret = getpass.getpass("Secret Key (input hidden): ").strip()
    if not secret:
        print("STOP: empty Secret Key", file=sys.stderr)
        return 1

    payload = f"GMAQ_READ_KEY={key}\nGMAQ_READ_SECRET={secret}\n"
    tmp = ENV_FILE.with_suffix(".readonly.tmp")
    tmp.write_text(payload)
    tmp.chmod(0o600)
    tmp.replace(ENV_FILE)

    print("written:", ENV_FILE)
    print("credential values accepted and stored locally; no prefix was displayed")
    return 0


if __name__ == "__main__":
    sys.exit(main())

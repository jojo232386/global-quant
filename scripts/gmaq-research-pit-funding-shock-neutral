#!/usr/bin/env python3
"""Run the preregistered PIT funding-shock dollar-neutral study.

This is an offline research command. It reads an explicit PIT data directory,
writes one results artifact, and never contacts an exchange or trading runtime.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import pathlib
import sys
from collections import defaultdict
from importlib.machinery import SourceFileLoader


ROOT = pathlib.Path(__file__).resolve().parents[1]
STUDY_ID = "study-2026-08-17-pit-funding-shock-neutral"
STUDY_DIR = ROOT / "research" / "backtests" / STUDY_ID
DEFAULT_DATA_DIR = ROOT / "user_data" / "data" / "pit"
SPLIT_UTC_MS = 1_781_568_000_000  # 2026-06-16T00:00:00Z
DAY_MS = 86_400_000
BAR_MS = 900_000
PARAMS = {
    "funding_lookback_records": 3,
    "long_legs": 3,
    "short_legs": 3,
    "holding_period_hours": 24,
    "notional_per_leg": 100.0,
    "initial_equity": 1000.0,
    "rebalance_utc": "00:00",
    "leverage": 1.0,
}


def load_module(name: str, path: pathlib.Path):
    loader = SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    assert spec and spec.loader
    spec.loader.exec_module(module)
    return module


def sha256_file(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def funding_shock(symbol_data: dict, signal_ts_ms: int, lookback: int = 3) -> float | None:
    records = [(ts, rate) for ts, rate in symbol_data["funding"] if ts <= signal_ts_ms]
    if len(records) < lookback + 1:
        return None
    latest = records[-1][1]
    previous = [rate for _, rate in records[-(lookback + 1) : -1]]
    return latest - sum(previous) / len(previous)


def run_rule(
    symbols: dict[str, dict],
    universes: dict[int, list[str]],
    *,
    cost_per_side: float,
    funding_multiplier: float = 1.0,
    funding_buffer: float = 0.0,
    lookback: int = 3,
    legs: int = 3,
    execution_delay_ms: int = 0,
) -> list[dict]:
    trades = []
    for day_ts in sorted(universes):
        signal_ts = day_ts - BAR_MS
        entry_ts = day_ts + execution_delay_ms
        exit_ts = entry_ts + DAY_MS
        eligible = []
        for symbol in universes[day_ts]:
            data = symbols.get(symbol)
            if not data:
                continue
            entry = data["open"].get(entry_ts)
            exit_price = data["open"].get(exit_ts)
            shock = funding_shock(data, signal_ts, lookback)
            if entry is None or exit_price is None or entry <= 0 or shock is None:
                continue
            eligible.append((symbol, shock, entry, exit_price))
        ranked = sorted(eligible, key=lambda item: (item[1], item[0]))
        if len(ranked) < 2 * legs:
            continue
        selected = [(item, 1) for item in ranked[:legs]] + [
            (item, -1) for item in ranked[-legs:]
        ]
        for (symbol, shock, entry, exit_price), side in selected:
            data = symbols[symbol]
            published_funding = sum(
                rate
                for ts, rate in data["funding"]
                if entry_ts < ts <= exit_ts
            )
            price_return = exit_price / entry - 1
            net_return = (
                side * price_return
                - 2 * cost_per_side
                - side * published_funding * funding_multiplier
                - funding_buffer
            )
            trades.append(
                {
                    "entry_ts_ms": entry_ts,
                    "exit_ts_ms": exit_ts,
                    "symbol": symbol,
                    "side": "long" if side == 1 else "short",
                    "signal_funding_shock": shock,
                    "entry": round(entry, 8),
                    "exit": round(exit_price, 8),
                    "published_funding": published_funding,
                    "net_return": net_return,
                    "notional": PARAMS["notional_per_leg"],
                }
            )
    return trades


def concentration(trades: list[dict]) -> float | None:
    pnl = defaultdict(float)
    for trade in trades:
        pnl[trade["symbol"]] += trade["notional"] * trade["net_return"]
    denominator = sum(abs(value) for value in pnl.values())
    return max((abs(value) for value in pnl.values()), default=0.0) / denominator if denominator else None


def segment_positive(trades: list[dict], midpoint_ms: int) -> bool:
    first = sum(t["notional"] * t["net_return"] for t in trades if t["entry_ts_ms"] < midpoint_ms)
    second = sum(t["notional"] * t["net_return"] for t in trades if t["entry_ts_ms"] >= midpoint_ms)
    return first > 0 and second > 0


def score(
    shared,
    train: list[dict],
    oos: list[dict],
    stress_oos: list[dict],
    sensitivity_returns: dict[str, float],
    delay_return: float,
    train_window: tuple[int, int],
    oos_window: tuple[int, int],
) -> tuple[str, dict, dict, dict]:
    train_metrics = shared.metrics(train, PARAMS["initial_equity"], *train_window)
    oos_metrics = shared.metrics(oos, PARAMS["initial_equity"], *oos_window)
    stress_metrics = shared.metrics(stress_oos, PARAMS["initial_equity"], *oos_window)
    rebalances = len({trade["entry_ts_ms"] for trade in oos})
    midpoint = SPLIT_UTC_MS + (oos_window[1] - SPLIT_UTC_MS) // 2
    conditions = {
        "oos_sharpe_ge_0.5": (oos_metrics["sharpe"] or 0) >= 0.5,
        "oos_baseline_positive": oos_metrics["total_return"] > 0,
        "oos_stress_positive": stress_metrics["total_return"] > 0,
        "oos_min_50_rebalances": rebalances >= 50,
        "train_oos_same_sign": train_metrics["total_return"] * oos_metrics["total_return"] > 0,
        "oos_max_drawdown_le_20pct": oos_metrics["max_drawdown"] <= 0.20,
        "symbol_concentration_le_40pct": (concentration(oos) or 1.0) <= 0.40,
        "both_sides_present": {trade["side"] for trade in oos} == {"long", "short"},
        "walk_forward_halves_positive": segment_positive(oos, midpoint),
        "parameter_neighbors_positive": all(value > 0 for value in sensitivity_returns.values()),
        "fifteen_minute_delay_positive": delay_return > 0,
    }
    if rebalances < 50:
        verdict = "INCONCLUSIVE"
    else:
        verdict = "PASS" if all(conditions.values()) else "REJECT"
    return verdict, conditions, train_metrics, {**oos_metrics, "stress": stress_metrics}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Run PIT funding-shock dollar-neutral research")
    parser.add_argument("--data-dir", type=pathlib.Path, default=DEFAULT_DATA_DIR)
    parser.add_argument("--output", type=pathlib.Path, default=STUDY_DIR / "results.json")
    args = parser.parse_args(argv)
    data_dir = args.data_dir.resolve()
    manifest_path = data_dir / "pit-manifest.json"
    universes_path = data_dir / "pit-universes.json"
    if not manifest_path.is_file() or not universes_path.is_file():
        parser.error("data directory must contain pit-manifest.json and pit-universes.json")

    pit = load_module("gmaq_pit_shared", ROOT / "scripts" / "gmaq-research-pit")
    shared = load_module("gmaq_metrics_shared", ROOT / "scripts" / "gmaq-research-backtest")
    pit.PIT_DIR = data_dir
    manifest = json.loads(manifest_path.read_text())
    universes_raw = json.loads(universes_path.read_text())
    universes = {int(day): list(symbols) for day, symbols in universes_raw.items()}
    symbols = {symbol: pit.load_symbol(symbol) for symbol in manifest["universe_symbols"]}
    symbols = {symbol: data for symbol, data in symbols.items() if data["open"]}

    baseline_cost = pit.COST_PARAMS["baseline"] / 10_000
    stress_cost = pit.COST_PARAMS["stress"] / 10_000
    baseline = run_rule(symbols, universes, cost_per_side=baseline_cost)
    stress = run_rule(
        symbols,
        universes,
        cost_per_side=stress_cost,
        funding_multiplier=5.0,
        funding_buffer=0.0001,
    )
    train = [trade for trade in baseline if trade["entry_ts_ms"] < SPLIT_UTC_MS]
    oos = [trade for trade in baseline if trade["entry_ts_ms"] >= SPLIT_UTC_MS]
    stress_oos = [trade for trade in stress if trade["entry_ts_ms"] >= SPLIT_UTC_MS]
    study_start = min(universes)
    study_end = max(universes) + DAY_MS
    train_window = (study_start, SPLIT_UTC_MS - 1)
    oos_window = (SPLIT_UTC_MS, study_end)

    sensitivity_returns = {}
    for label, lookback, legs in (("lookback_2", 2, 3), ("lookback_4", 4, 3), ("legs_2", 3, 2), ("legs_4", 3, 4)):
        variant = run_rule(
            symbols,
            universes,
            cost_per_side=stress_cost,
            funding_multiplier=5.0,
            funding_buffer=0.0001,
            lookback=lookback,
            legs=legs,
        )
        variant_oos = [trade for trade in variant if trade["entry_ts_ms"] >= SPLIT_UTC_MS]
        sensitivity_returns[label] = shared.metrics(
            variant_oos, PARAMS["initial_equity"], *oos_window
        )["total_return"]
    delayed = run_rule(
        symbols,
        universes,
        cost_per_side=stress_cost,
        funding_multiplier=5.0,
        funding_buffer=0.0001,
        execution_delay_ms=BAR_MS,
    )
    delayed_oos = [trade for trade in delayed if trade["entry_ts_ms"] >= SPLIT_UTC_MS]
    delay_return = shared.metrics(delayed_oos, PARAMS["initial_equity"], *oos_window)[
        "total_return"
    ]
    verdict, conditions, train_metrics, oos_metrics = score(
        shared,
        train,
        oos,
        stress_oos,
        sensitivity_returns,
        delay_return,
        train_window,
        oos_window,
    )

    funding_coverage = manifest.get("funding_coverage") or {}
    funding_request_complete = bool(funding_coverage) and all(
        bool(value.get("complete_request_window")) for value in funding_coverage.values()
    )
    promotion_inputs_complete = funding_request_complete and False  # no historical listing master
    if verdict == "PASS" and not promotion_inputs_complete:
        verdict = "INCONCLUSIVE"
    conditions.update(
        {
            "funding_request_window_complete": funding_request_complete,
            "historical_listing_master_complete": False,
            "account_costs_current_and_verified": False,
        }
    )

    short_losses = [
        -trade["notional"] * trade["net_return"]
        for trade in oos
        if trade["side"] == "short" and trade["net_return"] < 0
    ]
    result = {
        "study_id": STUDY_ID,
        "rule": "funding_shock_dollar_neutral",
        "params": {**PARAMS, "baseline_cost_bps_per_side": pit.COST_PARAMS["baseline"], "stress_cost_bps_per_side": pit.COST_PARAMS["stress"]},
        "split_utc_ms": SPLIT_UTC_MS,
        "data_dir_recorded_as": str(data_dir),
        "data_manifest_sha256": sha256_file(manifest_path),
        "pit_universes_sha256": sha256_file(universes_path),
        "candidate_pool_size": len(manifest["candidates"]),
        "pit_symbols": len(manifest["universe_symbols"]),
        "cost_model_sha256": pit.COST_PARAMS["sha256"],
        "engine_sha256": sha256_file(pathlib.Path(__file__)),
        "preregistration_sha256": sha256_file(STUDY_DIR / "preregistration.md"),
        "train": train_metrics,
        "out_of_sample": oos_metrics,
        "oos_rebalance_events": len({trade["entry_ts_ms"] for trade in oos}),
        "sensitivity_stress_returns": sensitivity_returns,
        "delayed_15m_stress_return": delay_return,
        "symbol_pnl_concentration": concentration(oos),
        "max_single_short_leg_loss_usdt": max(short_losses, default=0.0),
        "verdict": verdict,
        "verdict_conditions": conditions,
        "promotion_eligible": False,
        "residual_unknowns": [
            "candidate pool is today's top-100, not a complete historical listing master",
            "funding request-window completeness is absent from the supplied manifest",
            "historical spread, depth, impact, account fee, and maintenance-margin evidence is incomplete",
        ],
        "note": "Research verdict only. It does not authorize Demo entries or live trading and does not promise profitability.",
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())

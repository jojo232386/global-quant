#!/usr/bin/env python3
"""GMAQ exchange preflight (read-only, credential-free).

Queries Binance USD-M public market-data endpoints only and produces a
same-day verification manifest for the configured pair. Items that cannot be
verified without account credentials are reported as
UNVERIFIED_REQUIRES_AUTH; any of those keeps live readiness BLOCKED.

Unknown means stop: any public check that cannot be completed downgrades the
verdict to UNKNOWN and exits non-zero.

This script never reads or prints API credentials.
"""

import argparse
import json
import pathlib
import sys
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
CONFIG_PATH = ROOT / "user_data" / "config.json"
AUDIT_DIR = ROOT / "user_data" / "audit"
OUTPUT_PATH = AUDIT_DIR / "exchange-preflight.json"

FAPI = "https://fapi.binance.com"
ENDPOINTS = {
    "time": "/fapi/v1/time",
    "exchange_info": "/fapi/v1/exchangeInfo",
    "funding_info": "/fapi/v1/fundingInfo",
    "funding_rate": "/fapi/v1/fundingRate",
    "depth": "/fapi/v1/depth",
    "book_ticker": "/fapi/v1/ticker/bookTicker",
}
TIMEOUT_S = 8

AUTH_REQUIRED_ITEMS = [
    "margin_mode_on_account",
    "position_mode_on_account",
    "asset_mode_on_account",
    "api_permissions",
    "fee_rates_on_account",
    "account_sole_operator",
    "regional_eligibility",
    "withdrawal_permissions",
]


def get_json(url: str) -> dict | list | None:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            return json.loads(response.read().decode())
    except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, OSError):
        return None


def load_config() -> dict:
    return json.loads(CONFIG_PATH.read_text())


def config_is_credential_free(config: dict) -> bool:
    exchange = config.get("exchange", {})
    return config.get("dry_run") is True and not exchange.get("key") and not exchange.get("secret")


def symbol_from_config(config: dict) -> str | None:
    pairs = config.get("exchange", {}).get("pair_whitelist", [])
    if not pairs:
        return None
    return pairs[0].split(":")[0].replace("/", "")


def extract_filters(symbol_info: dict) -> dict:
    filters = {item["filterType"]: item for item in symbol_info.get("filters", [])}
    price_filter = filters.get("PRICE_FILTER", {})
    lot_filter = filters.get("LOT_SIZE", filters.get("MARKET_LOT_SIZE", {}))
    min_notional = filters.get("MIN_NOTIONAL", {})
    return {
        "tickSize": price_filter.get("tickSize"),
        "stepSize": lot_filter.get("stepSize"),
        "minQty": lot_filter.get("minQty"),
        "minNotional": min_notional.get("notional"),
    }


def extract_contract(symbol_info: dict) -> dict:
    return {
        "symbol": symbol_info.get("symbol"),
        "status": symbol_info.get("status"),
        "contractType": symbol_info.get("contractType"),
        "onboardDate": symbol_info.get("onboardDate"),
        "baseAsset": symbol_info.get("baseAsset"),
        "quoteAsset": symbol_info.get("quoteAsset"),
        "marginAsset": symbol_info.get("marginAsset"),
        "pricePrecision": symbol_info.get("pricePrecision"),
        "quantityPrecision": symbol_info.get("quantityPrecision"),
        "requiredMarginPercent": symbol_info.get("requiredMarginPercent"),
    }


def extract_implied_max_leverage(symbol_info: dict) -> float | None:
    """Public source: max leverage implied by requiredMarginPercent."""
    percent = symbol_info.get("requiredMarginPercent")
    if percent in (None, ""):
        return None
    value = float(percent)
    if value <= 0:
        return None
    return round(100.0 / value, 3)


def filter_funding_info(payload: list, symbol: str) -> dict | None:
    for item in payload or []:
        if item.get("symbol") == symbol:
            return item
    return None


def extract_funding(info_item: dict, rate_item: dict) -> dict:
    merged = dict(info_item or {})
    merged.update(rate_item or {})
    return {
        "symbol": merged.get("symbol"),
        "fundingRate": merged.get("fundingRate"),
        "fundingTime": merged.get("fundingTime"),
        "fundingIntervalHours": merged.get("fundingIntervalHours"),
        "adjustedFundingRateCap": merged.get("adjustedFundingRateCap"),
        "adjustedFundingRateFloor": merged.get("adjustedFundingRateFloor"),
    }


def build_commission_placeholder() -> dict:
    """Fee rates cannot be read from public endpoints anymore. Record the
    documented VIP0 default as a placeholder and require on-account
    verification before any live readiness claim."""
    return {
        "source": "binance-docs-default-vip0",
        "maker": 0.0002,
        "taker": 0.0005,
        "status": "PLACEHOLDER_UNVERIFIED",
    }


def extract_spread_bps(book_ticker: dict) -> float | None:
    bid = book_ticker.get("bidPrice")
    ask = book_ticker.get("askPrice")
    if bid in (None, "") or ask in (None, ""):
        return None
    bid, ask = float(bid), float(ask)
    mid = (bid + ask) / 2
    if mid <= 0:
        return None
    return (ask - bid) / mid * 10_000


def extract_depth(depth_payload: dict) -> dict:
    bids = depth_payload.get("bids", [])
    asks = depth_payload.get("asks", [])

    def side(levels):
        cumulative = 0.0
        notional_25 = None
        for price, qty in levels[:5]:
            level_notional = float(price) * float(qty)
            cumulative += level_notional
            if notional_25 is None and cumulative >= 25.0:
                notional_25 = float(price)
        return {
            "levels": [{"price": float(p), "qty": float(q)} for p, q in levels[:5]],
            "cumulative_notional_top5": round(cumulative, 2),
            "best_price_where_25usdt_fills": notional_25,
        }

    return {"bids": side(bids), "asks": side(asks)}


def check_pass(name: str, passed: bool, detail: str) -> dict:
    return {"name": name, "passed": passed, "detail": detail}


def run_preflight(symbol: str) -> dict:
    checks = []
    facts = {}
    fetched_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

    time_payload = get_json(f"{FAPI}{ENDPOINTS['time']}")
    server_time = time_payload.get("serverTime") if isinstance(time_payload, dict) else None
    offset_s = (time.time() - server_time / 1000) if server_time else None
    checks.append(check_pass("server time", server_time is not None, f"offset {offset_s:+.3f}s" if offset_s is not None else "unreachable"))
    facts["serverTime"] = server_time
    facts["clockOffsetSeconds"] = round(offset_s, 3) if offset_s is not None else None

    info = get_json(f"{FAPI}{ENDPOINTS['exchange_info']}")
    symbol_info = None
    if isinstance(info, dict):
        for item in info.get("symbols", []):
            if item.get("symbol") == symbol:
                symbol_info = item
                break
    checks.append(check_pass("exchange info", symbol_info is not None, f"symbol {symbol} present"))

    if symbol_info is not None:
        contract = extract_contract(symbol_info)
        facts["contract"] = contract
        checks.append(check_pass("contract status TRADING", contract["status"] == "TRADING", f"status={contract['status']}"))
        checks.append(check_pass("contract type PERPETUAL", contract["contractType"] == "PERPETUAL", f"type={contract['contractType']}"))
        checks.append(check_pass("quote asset USDT", contract["quoteAsset"] == "USDT", f"quote={contract['quoteAsset']}"))
        filters = extract_filters(symbol_info)
        facts["filters"] = filters
        checks.append(check_pass("precision/filters", all(filters.get(k) not in (None, "") for k in ("tickSize", "stepSize", "minQty")), json.dumps(filters)))
        checks.append(check_pass("minimum notional known", filters.get("minNotional") not in (None, ""), f"minNotional={filters.get('minNotional')}"))
        implied = extract_implied_max_leverage(symbol_info)
        facts["impliedMaxLeverage"] = implied
        checks.append(check_pass("leverage headroom >= 1x", implied is not None and implied >= 1.0, f"implied max {implied}x from requiredMarginPercent"))

    funding_info = get_json(f"{FAPI}{ENDPOINTS['funding_info']}")
    info_item = filter_funding_info(funding_info, symbol) if isinstance(funding_info, list) else None
    rate_payload = get_json(f"{FAPI}{ENDPOINTS['funding_rate']}?symbol={symbol}&limit=1")
    rate_item = rate_payload[0] if isinstance(rate_payload, list) and rate_payload else None
    funding_facts = extract_funding(info_item, rate_item)
    facts["funding"] = funding_facts
    checks.append(
        check_pass(
            "funding known",
            funding_facts.get("fundingRate") not in (None, "")
            and funding_facts.get("fundingIntervalHours") not in (None, ""),
            f"rate={funding_facts.get('fundingRate')} interval={funding_facts.get('fundingIntervalHours')}h",
        )
    )

    facts["commission"] = build_commission_placeholder()
    checks.append(
        check_pass(
            "commission placeholder recorded",
            True,
            "fee rates require authenticated account check (listed as UNVERIFIED_REQUIRES_AUTH)",
        )
    )

    book = get_json(f"{FAPI}{ENDPOINTS['book_ticker']}?symbol={symbol}")
    spread_bps = extract_spread_bps(book) if isinstance(book, dict) else None
    checks.append(check_pass("spread snapshot", spread_bps is not None and spread_bps >= 0, f"{spread_bps:.2f} bps" if spread_bps is not None else "unreachable"))
    facts["spreadBps"] = round(spread_bps, 3) if spread_bps is not None else None

    depth = get_json(f"{FAPI}{ENDPOINTS['depth']}?symbol={symbol}&limit=5")
    depth_facts = extract_depth(depth) if isinstance(depth, dict) else None
    checks.append(check_pass("depth snapshot", depth_facts is not None, "top-5 book captured" if depth_facts else "unreachable"))
    facts["depth"] = depth_facts

    public_failures = [item["name"] for item in checks if not item["passed"]]
    verdict = "UNKNOWN" if public_failures else "PASS_PUBLIC"

    manifest = {
        "scope": "read-only, credential-free",
        "fetchedAtUtc": fetched_at,
        "symbol": symbol,
        "verdict": verdict,
        "checks": checks,
        "facts": facts,
        "authRequiredUnverified": AUTH_REQUIRED_ITEMS,
        "liveReadiness": "BLOCKED" if AUTH_REQUIRED_ITEMS else "REVIEW",
        "note": "UNVERIFIED_REQUIRES_AUTH items can only be checked in a separately authorized read-only session; until then live stays BLOCKED.",
    }
    AUDIT_DIR.mkdir(parents=True, exist_ok=True)
    OUTPUT_PATH.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    return manifest


def final_verdict(checks: list[dict]) -> str:
    return "PASS_PUBLIC" if all(item["passed"] for item in checks) else "UNKNOWN"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gmaq-exchange-preflight", description="Read-only, credential-free Binance USD-M preflight")
    parser.add_argument("--symbol", default=None, help="override pair symbol, e.g. ETHUSDT")
    args = parser.parse_args(argv)

    if not CONFIG_PATH.is_file():
        print(json.dumps({"ok": False, "error": "config missing"}, indent=2))
        return 1
    config = load_config()
    if not config_is_credential_free(config):
        print(json.dumps({"ok": False, "error": "config carries credentials; this script is read-only public API only"}, indent=2))
        return 1
    symbol = args.symbol or symbol_from_config(config)
    if not symbol:
        print(json.dumps({"ok": False, "error": "no pair in whitelist"}, indent=2))
        return 1

    manifest = run_preflight(symbol)
    print(json.dumps(manifest, ensure_ascii=False, indent=2))
    return 0 if manifest["verdict"] == "PASS_PUBLIC" else 1


if __name__ == "__main__":
    sys.exit(main())

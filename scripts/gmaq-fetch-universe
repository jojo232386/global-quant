#!/usr/bin/env python3
"""Select the fixed top-N USD-M perpetual universe from public ticker data.

Credential-free. Writes universe.json with a sha256 pin. Excludes stablecoin
bases. This script never reads or prints API credentials.
"""

import argparse
import hashlib
import json
import pathlib
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
TICKER_URL = "https://fapi.binance.com/fapi/v1/ticker/24hr"
TIMEOUT_S = 10
STABLE_BASES = {"USDC", "BUSD", "USDP", "TUSD", "FDUSD", "USDE", "EUR", "AEUR", "USD1", "USDX", "BFUSD"}


def get_json(url: str) -> list | None:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            return json.loads(response.read().decode())
    except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, OSError):
        return None


def is_eligible(symbol: str) -> bool:
    return symbol.endswith("USDT") and symbol.removesuffix("USDT") not in STABLE_BASES


def select_universe(payload: list, top_n: int) -> list[str]:
    eligible = [
        item
        for item in payload or []
        if is_eligible(item.get("symbol", "")) and float(item.get("quoteVolume") or 0) > 0
    ]
    eligible.sort(key=lambda item: float(item.get("quoteVolume") or 0), reverse=True)
    return [item["symbol"] for item in eligible[:top_n]]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gmaq-fetch-universe", description="Select the fixed top-N USD-M universe")
    parser.add_argument("--top", type=int, default=15)
    parser.add_argument("--out", default=str(ROOT / "user_data" / "data" / "multi" / "universe.json"))
    args = parser.parse_args(argv)

    payload = get_json(TICKER_URL)
    if payload is None:
        print(json.dumps({"ok": False, "error": "ticker fetch failed"}, indent=2))
        return 1
    symbols = select_universe(payload, args.top)
    manifest = {
        "fetched_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "source": TICKER_URL,
        "top_n": args.top,
        "symbols": symbols,
    }
    payload_text = json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    manifest["sha256"] = hashlib.sha256(payload_text.encode()).hexdigest()
    out = pathlib.Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(payload_text)
    print(json.dumps(manifest, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    import sys

    sys.exit(main())

#!/usr/bin/env python3
"""Capture preregistered BTC/ETH spot-perpetual carry inputs.

Uses Binance public spot and USD-M endpoints only. Output is an unhashed source
capture for immediate Data Layer V1 migration; it is never a formal backtest
input by itself.
"""

from __future__ import annotations

import argparse
import calendar
import hashlib
import json
import pathlib
import time
import urllib.error
import urllib.parse
import urllib.request


ROOT = pathlib.Path(__file__).resolve().parents[1]
STUDY_ID = "study-2026-08-20-btceth-spot-perp-carry"
STUDY = ROOT / "research" / "backtests" / STUDY_ID
DEFAULT_OUT = ROOT / "user_data" / "data" / "carry"
SYMBOLS = ("BTCUSDT", "ETHUSDT")
EIGHT_HOURS_MS = 28_800_000
SPOT_URL = "https://api.binance.com/api/v3/klines"
MARK_URL = "https://fapi.binance.com/fapi/v1/markPriceKlines"
FUNDING_URL = "https://fapi.binance.com/fapi/v1/fundingRate"
MAX_RESPONSE_BYTES = 16 * 1024 * 1024


def sha256_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def get_json(url: str) -> list:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    last_error: Exception | None = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                payload = response.read(MAX_RESPONSE_BYTES + 1)
            if len(payload) > MAX_RESPONSE_BYTES:
                raise RuntimeError("public response exceeds capture safety bound")
            value = json.loads(payload)
            if not isinstance(value, list):
                raise RuntimeError("public response root is not a list")
            return value
        except (urllib.error.URLError, urllib.error.HTTPError, json.JSONDecodeError, OSError, RuntimeError) as error:
            last_error = error
            time.sleep(attempt + 1)
    raise RuntimeError(f"public capture failed: {type(last_error).__name__}") from last_error


def fetch_klines(url: str, symbol: str, start_ms: int, end_ms: int, limit: int) -> list[list]:
    rows: list[list] = []
    cursor = start_ms
    while cursor < end_ms:
        query = urllib.parse.urlencode({
            "symbol": symbol, "interval": "8h", "startTime": cursor,
            "endTime": end_ms - 1, "limit": limit,
        })
        batch = get_json(f"{url}?{query}")
        if not batch:
            break
        rows.extend(batch)
        last = int(batch[-1][0])
        if last < cursor:
            raise RuntimeError("kline pagination did not advance")
        cursor = last + 1
        time.sleep(0.15)
    expected = list(range(start_ms, end_ms, EIGHT_HOURS_MS))
    filtered = [row for row in rows if start_ms <= int(row[0]) < end_ms]
    if [int(row[0]) for row in filtered] != expected:
        raise RuntimeError(f"{symbol} 8h kline coverage mismatch for {url}")
    return filtered


def fetch_funding(symbol: str, start_ms: int, end_ms: int) -> list[dict]:
    rows: list[dict] = []
    cursor = start_ms
    while cursor < end_ms:
        query = urllib.parse.urlencode({
            "symbol": symbol, "startTime": cursor, "endTime": end_ms - 1,
            "limit": 1000,
        })
        batch = get_json(f"{FUNDING_URL}?{query}")
        if not batch:
            break
        rows.extend(batch)
        last = int(batch[-1]["fundingTime"])
        if last < cursor:
            raise RuntimeError("funding pagination did not advance")
        cursor = last + 1
        time.sleep(0.15)
    unique = {int(item["fundingTime"]): item for item in rows}
    return [unique[key] for key in sorted(unique) if start_ms <= key < end_ms]


def jsonl(rows: list[dict]) -> bytes:
    return b"".join(
        (json.dumps(row, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()
        for row in rows
    )


def kline_records(rows: list[list], *, volume: bool) -> list[dict]:
    records = []
    for row in rows:
        if len(row) < (6 if volume else 5):
            raise RuntimeError("kline row is incomplete")
        item = {
            "open_time_utc_ms": int(row[0]), "open": row[1], "high": row[2],
            "low": row[3], "close": row[4],
        }
        if volume:
            item["volume"] = row[5]
        records.append(item)
    return records


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gmaq-fetch-carry")
    parser.add_argument("--start", default="2020-01-01", help="inclusive UTC date")
    parser.add_argument("--end", default="2026-08-20", help="exclusive UTC date")
    parser.add_argument("--out-dir", default=str(DEFAULT_OUT))
    args = parser.parse_args(argv)
    start_ms = int(calendar.timegm(time.strptime(args.start, "%Y-%m-%d")) * 1000)
    end_ms = int(calendar.timegm(time.strptime(args.end, "%Y-%m-%d")) * 1000)
    if end_ms <= start_ms or end_ms % EIGHT_HOURS_MS:
        parser.error("capture window must be positive and end on an 8h UTC boundary")
    out = pathlib.Path(args.out_dir).expanduser().resolve()
    out.mkdir(parents=True, exist_ok=True)
    manifest = {
        "schema_version": 1, "study_id": STUDY_ID,
        "fetched_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "source_spot_klines": SPOT_URL, "source_mark_klines": MARK_URL,
        "source_funding": FUNDING_URL, "start_inclusive": args.start,
        "end_exclusive": args.end, "interval": "8h", "symbols": {},
        "preregistration_sha256": sha256_bytes((STUDY / "preregistration.md").read_bytes()),
        "credential_scope": "public_endpoints_only",
    }
    expected = list(range(start_ms, end_ms, EIGHT_HOURS_MS))
    for symbol in SYMBOLS:
        spot = kline_records(fetch_klines(SPOT_URL, symbol, start_ms, end_ms, 1000), volume=True)
        marks = kline_records(fetch_klines(MARK_URL, symbol, start_ms, end_ms, 1500), volume=False)
        mark_open = {int(item["open_time_utc_ms"]): item["open"] for item in marks}
        funding = fetch_funding(symbol, start_ms, end_ms)
        buckets = [int(item["fundingTime"]) // EIGHT_HOURS_MS * EIGHT_HOURS_MS for item in funding]
        if buckets != expected or len(set(buckets)) != len(buckets):
            raise RuntimeError(f"{symbol} funding settlement-bucket coverage mismatch")
        fallback = 0
        for item, bucket in zip(funding, buckets, strict=True):
            item["symbol"] = symbol
            if float(item.get("markPrice") or 0) > 0:
                item["markPriceSource"] = "fundingRate_response"
            else:
                item["markPrice"] = mark_open[bucket]
                item["markPriceSource"] = "fapi_8h_mark_kline_open_fallback"
                fallback += 1
        payloads = {
            "spot_8h": jsonl(spot), "mark_8h": jsonl(marks),
            "funding": jsonl(funding),
        }
        names = {
            "spot_8h": f"{symbol}-spot-8h.jsonl",
            "mark_8h": f"{symbol}-mark-8h.jsonl",
            "funding": f"{symbol}-funding.jsonl",
        }
        for role, payload in payloads.items():
            (out / names[role]).write_bytes(payload)
        manifest["symbols"][symbol] = {
            "spot_8h_path": names["spot_8h"], "spot_8h_sha256": sha256_bytes(payloads["spot_8h"]),
            "spot_8h_bars": len(spot), "first_spot_utc_ms": expected[0], "last_spot_utc_ms": expected[-1],
            "mark_8h_path": names["mark_8h"], "mark_8h_sha256": sha256_bytes(payloads["mark_8h"]),
            "mark_8h_bars": len(marks), "funding_path": names["funding"],
            "funding_sha256": sha256_bytes(payloads["funding"]), "funding_records": len(funding),
            "first_funding_utc_ms": int(funding[0]["fundingTime"]),
            "last_funding_utc_ms": int(funding[-1]["fundingTime"]),
            "funding_mark_price_fallback_records": fallback,
            "funding_request_window_complete": True,
        }
        print(f"OK {symbol}: {len(spot)} spot bars, {len(marks)} mark bars, {len(funding)} funding events")
    unhashed = json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    manifest["manifest_payload_sha256"] = sha256_bytes(unhashed.encode())
    (out / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    print(json.dumps({"verdict": "CAPTURED_NOT_FORMAL_INPUT", "source_dir": str(out)}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
